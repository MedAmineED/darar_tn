# ------------------------------------------------------------------
# Server-side only. NEVER prefix backend URLs with NEXT_PUBLIC_ —
# the storefront calls the API from Server Components / route handlers,
# so the browser never needs (and must not receive) these values.
# ------------------------------------------------------------------

# Base URL of the NestJS storefront API (includes the /api/v1 prefix).
API_BASE_URL=http://localhost:4000/api/v1

# Host that serves product images (/uploads/**). Defaults to the API
# origin (API_BASE_URL without /api/v1) when omitted.
MEDIA_BASE_URL=http://localhost:4000

# Public canonical origin of the storefront itself (used for SEO:
# canonical URLs, Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
