# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed origins for CORS (frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3002

# ── Database ────────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/darihome_admin"

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Refresh cookie ──────────────────────────────────────────
REFRESH_COOKIE_NAME=darihome_rt
# In production set COOKIE_SECURE=true (HTTPS) and COOKIE_DOMAIN accordingly
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# ── Seed (initial SUPER_ADMIN) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@darihome.tn
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin

# ── Rate limiting (auth endpoints) ──────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ── Uploads / storage ───────────────────────────────────────
# Local storage directory (relative to backend root) and max image size (MB)
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5
